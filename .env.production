# Production Environment Variables for GitHub Pages

# Backend API URL (required for full functionality)
# Replace with your deployed backend URL
# Examples:
#   REACT_APP_API_URL=https://your-backend.onrender.com
#   REACT_APP_API_URL=https://your-backend.railway.app
#   REACT_APP_API_URL=https://your-backend.fly.dev
REACT_APP_API_URL=

# If not set, the app will fall back to direct Jikan API calls
# (which may be slower due to rate limiting)
